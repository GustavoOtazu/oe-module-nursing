{% extends "patient/card/card_base.html.twig" %}

{% block content %}
<div class="pl-1">
    {% if admission %}
        <table class="table table-sm table-borderless mb-1">
            <tbody>
                {% if admission.nro_registro %}
                <tr>
                    <td class="font-weight-bold w-50">{{ "Reg. #"|xlt }}</td>
                    <td>{{ admission.nro_registro|text }}</td>
                </tr>
                {% endif %}
                <tr>
                    <td class="font-weight-bold">{{ "Admission Date"|xlt }}</td>
                    <td>{{ admission.admission_date|date("d/m/Y")|text }}</td>
                </tr>
                {% if admission.departamento %}
                <tr>
                    <td class="font-weight-bold">{{ "Department"|xlt }}</td>
                    <td>{{ (labels[admission.departamento] ?? admission.departamento)|text }}</td>
                </tr>
                {% endif %}
                {% if admission.servicio %}
                <tr>
                    <td class="font-weight-bold">{{ "Service"|xlt }}</td>
                    <td>{{ (labels[admission.servicio] ?? admission.servicio)|text }}</td>
                </tr>
                {% endif %}
                {% if admission.cuarto or admission.cama %}
                <tr>
                    <td class="font-weight-bold">{{ "Ward / Bed"|xlt }}</td>
                    <td>{{ admission.cuarto|upper|text }}{% if admission.cuarto and admission.cama %} / {% endif %}{{ admission.cama|text }}</td>
                </tr>
                {% endif %}
                {% if admission.equipo %}
                <tr>
                    <td class="font-weight-bold">{{ "Primary team"|xlt }}</td>
                    <td>{{ admission.equipo|text }}</td>
                </tr>
                {% endif %}
                {% if admission.location_since %}
                <tr>
                    <td class="font-weight-bold">{{ "In this bed since"|xlt }}</td>
                    <td>{{ admission.location_since|date("d/m/Y H:i")|text }}</td>
                </tr>
                {% endif %}
            </tbody>
        </table>
        <div class="mt-1">
            <a class="btn btn-sm btn-outline-primary"
               href="{{ webroot|attr }}{{ moduleBasePath|attr }}/dashboard/editar_internado.php?id={{ admission.encounter_id|attr_url }}"
               onclick="top.restoreSession()">
                <i class="fa fa-exchange-alt"></i>&nbsp;{{ "Location and transfers"|xlt }}
            </a>
        </div>
    {% else %}
        <p class="text-muted pl-1 mb-1">{{ "No active inpatient admission."|xlt }}</p>
    {% endif %}

    {% if prependedInjection is defined %}{{ prependedInjection|raw }}{% endif %}
    {% if appendedInjection is defined %}{{ appendedInjection|raw }}{% endif %}
</div>
{% endblock %}
